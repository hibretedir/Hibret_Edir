# Environment example for local development and Netlify

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth
JWT_SECRET=replace-with-a-secure-random-string
# Auth — board login off by default for local dev; set true on Netlify for production
# ADMIN_AUTH_ENABLED=true

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# Random secret for scheduled PayPal sync (set in Netlify env — required for auto sync)
CRON_SECRET=

# Notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hibretedirautomation@gmail.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated board alert recipients (application + profile changes)
BOARD_NOTIFY_EMAIL=hibretedirtext@gmail.com
BOARD_NOTIFY_PHONE=4245475594
# Used in application review links in board emails
ADMIN_SITE_URL=https://hibretedir.com

# Storage (S3 / Cloudinary)
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local / dev
NODE_ENV=development
JWT_EXPIRES_IN=1d
