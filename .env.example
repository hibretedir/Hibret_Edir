# Environment example for local development and Netlify

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth
JWT_SECRET=replace-with-a-secure-random-string
# Auth — board login off by default for local dev; set true on Netlify for production
# ADMIN_AUTH_ENABLED=true
# Board logins: invite emails in Admin → Security → Board Access (or scripts/create_board_admin.py for bootstrap)
# Comma-separated super admins — full access + can grant permissions to other board members
# BOARD_SUPER_ADMIN_EMAILS=you@example.com

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# Random secret for scheduled PayPal sync (set in Netlify env — required for auto sync)
CRON_SECRET=

# Notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@hibretedir.com
SENDGRID_REPLY_TO=hibretedirtext@gmail.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated board alert recipients (application + profile changes)
BOARD_NOTIFY_EMAIL=hibretedirtext@gmail.com
BOARD_NOTIFY_PHONE=4245475594
# Optional — destinations for npm run test:notify -- --send (local only)
TEST_NOTIFY_EMAIL=
TEST_NOTIFY_PHONE=
# Used in application review links in board emails
ADMIN_SITE_URL=https://hibretedir.com
# Member-facing links in invitation/SMS emails (local dev — use localhost; Netlify sets URL automatically)
PUBLIC_SITE_URL=http://localhost:8888

# Optional — scanned membership applications (Google Drive parent folder)
# GOOGLE_DRIVE_APPLICATIONS_FOLDER_ID=1RC-veuhY2VqR_XdcgUz0u5hYIhc60Yev
# APPLICATION_SCANS_ROOT=G:/My Drive/Social/Hibret Edir/Members Scanned Applications
# APPLICATION_SCANS_POLL_MS=60000
# Auto: npm run dev starts watch_application_scans.js; or npm run watch:scans / npm run sync:scans

# Storage (S3 / Cloudinary)
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local / dev
NODE_ENV=development
JWT_EXPIRES_IN=1d

# Membership: 200 member families + 1 reserved system-validation slot
MEMBER_CAP=201

# System validation demo (full onboarding lifecycle test + reset)
DEMO_QA_ENABLED=true
DEMO_QA_EMAIL=hibretedirtest@gmail.com
# Must NOT match any real member mobile (e.g. 3105550199 — not a live member phone)
DEMO_QA_PHONE=
DEMO_QA_NAME=Hibret Edir QA Test
# Real PayPal test amount for QA only (production members stay $200)
REGISTRATION_FEE=1
# Funeral announcement: auto-suggest no collection when PayPal balance >= this (default 50000)
# ANNOUNCEMENT_FUND_THRESHOLD=50000
